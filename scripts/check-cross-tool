#!/usr/bin/env python3
"""Run optional acceptance against an explicitly pinned Controller/Finalizer pair."""

import argparse
import hashlib
import json
import os
import runpy
import subprocess
import sys
import tomllib
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TESTS = (
    "tests/test_branch_retirement_git_finalizer_acceptance.py::"
    "test_the_released_consumer_accepts_a_controller_plan_and_rejects_drift",
