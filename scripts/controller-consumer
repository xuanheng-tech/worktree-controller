def controller_arguments(arguments):
    """Translate the published v1 spelling without changing values or commands."""
    result = []
    for index, value in enumerate(arguments):
        if value == "--":
            return [*result, *arguments[index:]]
        result.append("--client-id" if value == "--provider" else value)
    return result


