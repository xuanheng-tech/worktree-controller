def _present(path):
    try:
        path.lstat()
    except OSError:
        return False
    return True


def _canonical_protected(root):
    policy_path = root / ".agents" / "worktree-policy.toml"
    if not _present(policy_path):
        return True
    try:
        data = tomllib.loads(policy_path.read_text(encoding="utf-8"))
        canonical = data.get("canonical")
        if isinstance(canonical, dict) and isinstance(canonical.get("protected"), bool):
            return canonical["protected"]
    except (OSError, UnicodeError, ValueError):
        return True
    return True


def _scan_ancestors_for_governance(candidate):
    """Inspect ``candidate`` and its ancestors.

    Returns ``("canonical", root, protected)``, ``("linked", root, False)``,
    ``("outside", None, False)``, or ``("uncertain", None, True)``.
    """
    existing = next((p for p in (candidate, *candidate.parents) if _present(p)), None)
    if existing is None or existing == Path("/"):
        return "uncertain", None, True
    for parent in (candidate, *candidate.parents):
        if not parent.is_dir():
            continue
        git_entry = parent / ".git"
        if not _present(git_entry):
            if _present(parent / ".agents" / "worktree-policy.toml"):
                return "uncertain", None, True
            continue
        try:
            st = git_entry.lstat()
        except OSError:
            return "uncertain", None, True
        if os.path.isdir(git_entry) and not os.path.islink(git_entry):
            if _present(parent / ".agents" / "worktree-policy.toml") or (
                git_entry / "worktree-controller"
            ).is_dir():
                return "canonical", parent, _canonical_protected(parent)
            return "outside", None, False
        if os.path.isfile(git_entry) and not os.path.islink(git_entry):
            try:
                with git_entry.open("rb") as handle:
                    pointer = os.fsdecode(handle.read(_GITDIR_LIMIT + 1)).strip()
            except OSError:
                return "uncertain", None, True
            if len(pointer) > _GITDIR_LIMIT or not pointer.startswith("gitdir: "):
                return "uncertain", None, True
            admin = (parent / pointer.removeprefix("gitdir: ")).resolve(strict=False)
            common = admin
            commondir = admin / "commondir"
            if _present(commondir):
                try:
                    with commondir.open("rb") as handle:
                        rel = os.fsdecode(handle.read(_GITDIR_LIMIT + 1)).strip()
                except OSError:
                    return "uncertain", None, True
                if not rel or len(rel) > _GITDIR_LIMIT:
                    return "uncertain", None, True
                common = (admin / rel).resolve(strict=False)
            if _present(parent / ".agents" / "worktree-policy.toml") or (
                common / "worktree-controller"
            ).is_dir():
                return "linked", parent, False
            return "outside", None, False
        if st:
            return "uncertain", None, True
    return "outside", None, False


def inspect_governed_root(path):
    """Classify ``path`` across both its lexical path and symlink-resolved target."""
    try:
        expanded = Path(os.path.expanduser(str(path)))
        if not expanded.is_absolute():
            return "uncertain", None, True
        resolved = expanded.resolve(strict=False)
    except OSError:
        return "uncertain", None, True
    lexical_norm = Path(os.path.normpath(str(expanded)))
    checks = [resolved]
    if lexical_norm != resolved:
        checks.append(lexical_norm)
    best = ("outside", None, False)
    for candidate in checks:
        kind, root, protected = _scan_ancestors_for_governance(candidate)
        if kind == "canonical" and protected:
            return kind, root, True
        if kind == "linked":
            best = (kind, root, False)
        elif kind == "uncertain" and best[0] == "outside":
            best = (kind, None, True)
        elif kind == "canonical" and best[0] == "outside":
            best = (kind, root, protected)
    return best


def _split_strict_readonly_stages(command):
    """Return list of simple command stages iff ``command`` has no shell writes/substitutions."""
    if not isinstance(command, str) or not command.strip() or "\x00" in command:
        return None
    stages = []
    buf = []
    in_sq = False
    in_dq = False
    escaped = False
    i = 0
    n = len(command)
    while i < n:
        ch = command[i]
        if escaped:
            buf.append(ch)
            escaped = False
            i += 1
            continue
        if ch == "\\" and not in_sq:
            buf.append(ch)
            escaped = True
            i += 1
            continue
        if ch == "'" and not in_dq:
            in_sq = not in_sq
            buf.append(ch)
            i += 1
            continue
        if ch == '"' and not in_sq:
            in_dq = not in_dq
            buf.append(ch)
            i += 1
            continue
        # Command substitution executes inside double quotes too.
        if not in_sq and (ch == "`" or command[i : i + 2] == "$("):
            return None
        if not in_sq and not in_dq:
            if ch in "(){}<":
                return None
            if ch == "#" and (not buf or buf[-1].isspace()):
                while i < n and command[i] != "\n":
                    i += 1
                continue
            if ch in ";\n":
                stage = "".join(buf).strip()
                if stage:
                    stages.append(stage)
                buf = []
                i += 1
                continue
            if command[i : i + 2] in ("&&", "||"):
                stage = "".join(buf).strip()
                if stage:
                    stages.append(stage)
                buf = []
                i += 2
                continue
            if ch == "|":
                stage = "".join(buf).strip()
                if not stage:
                    return None
                stages.append(stage)
                buf = []
                i += 1
                continue
            # Allow only exact benign fd dups / /dev/null sinks; reject all other > or &.
            if ch == ">" or (ch in "12" and command[i + 1 : i + 2] == ">" and (i == 0 or command[i - 1].isspace())):
                m = _SAFE_REDIR_RE.match(command[i:])
                if not m:
                    return None
                buf.append(" ")
                i += len(m.group(0))
                continue
            if ch == "&":
                return None
        buf.append(ch)
        i += 1
    if in_sq or in_dq or escaped:
        return None
    tail = "".join(buf).strip()
    if tail:
        stages.append(tail)
    return stages if stages else None


def _is_readonly_git(args):
    i = 0
    subcmd = None
    sub_args = []
    while i < len(args):
        arg = args[i]
        if arg in ("-C", "--git-dir", "--work-tree"):
            if i + 1 >= len(args):
                return False
            i += 2
            continue
        if arg.startswith(("--git-dir=", "--work-tree=")) or arg in (
            "--no-pager",
            "--literal-pathspecs",
            "--bare",
            "--no-optional-locks",
        ):
            i += 1
            continue
        if arg.startswith("-"):
            # Reject -c / --config-env / --exec-path / any unknown global flag.
            return False
        subcmd = arg
        sub_args = args[i + 1 :]
        break
    if subcmd is None:
        return False
    if subcmd in _GIT_READONLY_SUBCMDS:
        for arg in sub_args:
            if arg in ("-o", "--output", "--ext-diff", "--textconv") or arg.startswith("--output="):
                return False
        return True
    if subcmd == "branch":
        allowed = {
            "-a", "--all", "-r", "--remotes", "-l", "--list", "-v", "-vv",
            "--verbose", "--show-current", "--merged", "--no-merged",
            "--contains", "--points-at", "--color", "--no-color", "--abbrev",
        }
        i = 0
        while i < len(sub_args):
            arg = sub_args[i]
            if arg in ("--merged", "--no-merged", "--contains", "--points-at"):
                i += 2
                continue
            if arg in allowed or arg.startswith(("--sort=", "--format=", "--color=", "--abbrev=")):
                i += 1
                continue
            return False
        return True
    if subcmd == "tag":
        if not sub_args:
            return True
        return all(
            a in ("-l", "--list", "-v", "--verify") or a.startswith(("--sort=", "--format=", "-n"))
            for a in sub_args
            if a.startswith("-")
        ) and any(a in ("-l", "--list", "-v", "--verify") for a in sub_args)
    if subcmd == "config":
        read_flags = {"--get", "--get-all", "--list", "-l", "--show-origin", "--show-scope", "--null", "-z"}
        has_read = False
        positional = 0
        for arg in sub_args:
            if arg in read_flags:
                has_read = True
            elif arg in ("--local", "--global", "--system", "--worktree"):
                continue
            elif arg.startswith("-"):
                return False
            else:
                positional += 1
        return has_read and positional <= 1
    return False


def _is_readonly_sed(args):
    has_quiet = False
    scripts = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-n", "--quiet", "--silent"):
            has_quiet = True
            i += 1
            continue
        if arg in ("-e", "--expression"):
            if i + 1 >= len(args):
                return False
            scripts.append(args[i + 1])
            i += 2
            continue
        if arg.startswith("-"):
            return False
        if not scripts:
            scripts.append(arg)
        i += 1
    return has_quiet and bool(scripts) and all(_SED_SAFE_SCRIPT_RE.fullmatch(s) for s in scripts)


def _is_safe_worktree_session(args, cwd):
    """Allow `worktree-session` fast-path only when `--path` is not a protected canonical checkout."""
    target = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            break
        if arg == "--path" and i + 1 < len(args):
            target = args[i + 1]
            i += 2
            continue
        if arg.startswith("--path="):
            target = arg.split("=", 1)[1]
            i += 1
            continue
        i += 1
    if not target:
        return False
    expanded = Path(os.path.expanduser(target))
    if not expanded.is_absolute():
        expanded = Path(cwd) / expanded
    kind, _root, protected = inspect_governed_root(expanded)
    return not (kind == "canonical" and protected)


def _is_strict_readonly_stage(stage, cwd):
    try:
        tokens = shlex.split(stage)
    except ValueError:
        return False
    while tokens and _VAR_ASSIGN_TOKEN_RE.match(tokens[0]):
        tokens = tokens[1:]
    if not tokens:
        return False
    cmd = Path(tokens[0]).name
    args = tokens[1:]
    if cmd in _GOVERNANCE_CLIS:
        return True
    if cmd == "worktree-session":
        return _is_safe_worktree_session(args, cwd)
    if cmd in _PURE_READONLY_COMMANDS:
        return True
    if cmd == "sort":
        return not any(a in ("-o", "--output") or a.startswith("--output=") for a in args)
    if cmd == "git":
        return _is_readonly_git(args)
    if cmd == "sed":
        return _is_readonly_sed(args)
    if cmd == "find":
        mut_flags = {
            "-delete", "-exec", "-execdir", "-ok", "-okdir", "-fls", "-fprint", "-fprint0", "-fprintf"
        }
        return not any(a in mut_flags for a in args)
    if cmd == "systemctl":
        ro_sys = {
            "status", "list-units", "list-timers", "list-unit-files",
            "is-active", "is-enabled", "show", "cat",
        }
        pos = [a for a in args if not a.startswith("-")]
        return bool(pos) and pos[0] in ro_sys
    if cmd == "ruff":
        return (
            bool(args)
            and args[0] == "check"
            and not any(
                a in ("--fix", "--unsafe-fixes", "--fix-only", "-o", "--output-file")
                or a.startswith("--output-file=")
                for a in args[1:]
            )
        )
    return False


def is_strict_readonly_bash(command, cwd):
    """Return True only when every stage is provably pure read-only."""
    stages = _split_strict_readonly_stages(command)
    if not stages:
        return False
    cur_cwd = Path(os.path.expanduser(cwd)).resolve(strict=False)
    for stage in stages:
        if not _is_strict_readonly_stage(stage, str(cur_cwd)):
            return False
        try:
            words = shlex.split(stage)
        except ValueError:
            return False
        if words and words[0] == "cd" and len(words) >= 2 and words[1] != "-":
            dest = Path(os.path.expanduser(words[1]))
            cur_cwd = (dest if dest.is_absolute() else cur_cwd / dest).resolve(strict=False)
    return True


def _path_within(child, root):
    try:
        child.relative_to(root)
    except ValueError:
        return False
    return True


def _is_safe_owner_and_mode(st):
    uid = os.getuid()
    gid = os.getgid()
    if st.st_uid not in (uid, 0):
        return False
    if (st.st_mode & 0o002) != 0:
        return False
    if (st.st_mode & 0o020) != 0:
        if st.st_uid != uid or st.st_gid != gid:
            return False
        try:
            user_name = pwd.getpwuid(uid).pw_name
            group_members = set(grp.getgrgid(gid).gr_mem)
        except KeyError:
            return False
        if not group_members.issubset({user_name}):
            return False
    return True


def _is_trusted_research_workspace_exe(token):
    """Verify ``token`` resolves to the user's trusted installed ``research-workspace`` CLI."""
    if not token or "=" in token:
        return False
    home = Path.home().resolve(strict=False)
    allowed_link_dirs = (home / "bin", home / ".local" / "bin")
    allowed_target_dirs = (
        home / "bin",
        home / ".local" / "bin",
        home / ".local" / "share" / "uv" / "tools",
    )
    if token == "research-workspace":
        located = shutil.which("research-workspace")
        if not located:
            return False
        candidate = Path(located)
    else:
        if not (token.startswith("/") or token.startswith("~/")):
            return False
        candidate = Path(os.path.expanduser(token))
        if candidate.name != "research-workspace":
            return False
    try:
        lexical_parent = candidate.parent.resolve(strict=True)
    except OSError:
        return False
    if not any(_path_within(lexical_parent, d.resolve(strict=False)) for d in allowed_link_dirs):
        return False
    try:
        resolved = candidate.resolve(strict=True)
        st = resolved.stat()
    except OSError:
        return False
    if not any(_path_within(resolved, d.resolve(strict=False)) for d in allowed_target_dirs):
        return False
    if not stat.S_ISREG(st.st_mode) or not os.access(resolved, os.X_OK):
        return False
    if not _is_safe_owner_and_mode(st):
        return False
    cur = resolved.parent
    while True:
        try:
            pst = cur.stat()
        except OSError:
            return False
        if not _is_safe_owner_and_mode(pst):
            return False
        if cur == home or cur == cur.parent:
            break
        cur = cur.parent
    return True


def _is_safe_research_request_file(raw_path):
    """Allow only non-symlink absolute JSON files outside credential and internal state roots."""
    if not raw_path or not (raw_path.startswith("/") or raw_path.startswith("~/")):
        return False
    expanded = Path(os.path.expanduser(raw_path))
    if not expanded.is_absolute():
        return False
    try:
        if expanded.is_symlink():
            return False
    except OSError:
        return False
    lexical = Path(os.path.normpath(str(expanded)))
    try:
        resolved = expanded.resolve(strict=False)
    except OSError:
        return False
    home = Path.home().resolve(strict=False)
    blocked_roots = (
        home / ".ssh",
        home / ".gnupg",
        home / ".aws",
        home / ".config" / "rclone",
        home / ".local" / "state" / "agent-toolchain",
        home / ".kube",
        home / ".docker",
        Path("/etc"),
        Path("/proc"),
        Path("/sys"),
        Path("/dev"),
        Path("/root"),
    )
    for candidate in (lexical, resolved):
        if candidate.suffix != ".json":
            return False
        lower_name = candidate.name.lower()
        if lower_name.startswith(".env") or lower_name in _SENSITIVE_REQUEST_BASENAMES:
            return False
        for blocked in blocked_roots:
            if _path_within(candidate, blocked):
                return False
    return True


def _validate_research_job_flag_value(kind, value):
    if kind == "request_file":
        return _is_safe_research_request_file(value)
    if kind == "b64":
        return bool(_RESEARCH_JOB_B64_RE.fullmatch(value))
    if kind == "id":
        return bool(_RESEARCH_JOB_ID_RE.fullmatch(value))
    if kind == "idem":
        return bool(_RESEARCH_JOB_IDEM_RE.fullmatch(value))
    if kind == "state":
        return bool(_RESEARCH_JOB_STATE_RE.fullmatch(value))
    if kind == "posint":
        return bool(_RESEARCH_JOB_POSINT_RE.fullmatch(value))
    if kind == "reason":
        return bool(_RESEARCH_JOB_REASON_RE.fullmatch(value))
    return False


def is_safe_research_job_call(command):
    """Return True iff ``command`` is a single structured ``research-workspace job`` call."""
    if not isinstance(command, str) or not command.strip():
        return False
    if any(ch in _RESEARCH_JOB_FORBIDDEN_CHARS for ch in command):
        return False
    try:
        tokens = shlex.split(command, comments=False)
    except ValueError:
        return False
    if len(tokens) < 3:
        return False
    if not _is_trusted_research_workspace_exe(tokens[0]):
        return False
    if tokens[1] != "job":
        return False
    spec = _RESEARCH_JOB_ACTIONS.get(tokens[2])
    if spec is None:
        return False
    value_flags = spec["value_flags"]
    bool_flags = spec["bool_flags"]
    seen = set()
    i = 3
    while i < len(tokens):
        tok = tokens[i]
        if tok == "--" or not tok.startswith("--"):
            return False
        if "=" in tok:
            flag, val = tok.split("=", 1)
            if flag not in value_flags or flag in seen:
                return False
            if not _validate_research_job_flag_value(value_flags[flag], val):
                return False
            seen.add(flag)
            i += 1
            continue
        if tok in bool_flags:
            if tok in seen:
                return False
            seen.add(tok)
            i += 1
            continue
        if tok in value_flags:
            if tok in seen or i + 1 >= len(tokens):
                return False
            val = tokens[i + 1]
            if not _validate_research_job_flag_value(value_flags[tok], val):
                return False
            seen.add(tok)
            i += 2
            continue
        return False
    if not spec["required_flags"].issubset(seen):
        return False
    xor_flags = spec["xor_flags"]
    if xor_flags is not None:
        present = sum(1 for flag in xor_flags if flag in seen)
        if present != 1:
            return False
    return True


def _expand_simple_vars(text, env_vars):
    def _sub(match):
        name = match.group(1) or match.group(2)
        if name == "HOME":
            return str(Path.home())
        return env_vars.get(name, match.group(0))

    prev = text
    for _ in range(3):
        nxt = _VAR_REF_RE.sub(_sub, prev)
        if nxt == prev:
            break
        prev = nxt
    return prev


def collect_bash_governed_targets(command, cwd):
    """Collect governed checkouts touched by ``cwd``, `cd` targets, or path tokens.

    Returns ``(canonical_roots, linked_roots, uncertain)``.
    """
    canonical_roots = []
    linked_roots = []
    uncertain = False

    def record(candidate_path):
        nonlocal uncertain
        kind, root, protected = inspect_governed_root(candidate_path)
        if kind == "canonical" and protected:
            if root not in canonical_roots:
                canonical_roots.append(root)
        elif kind == "linked":
            if root not in linked_roots:
                linked_roots.append(root)
        elif kind == "uncertain":
            uncertain = True

    cur_cwd = Path(os.path.expanduser(cwd)).resolve(strict=False)
    record(cur_cwd)
    if not isinstance(command, str) or not command.strip():
        return canonical_roots, linked_roots, uncertain

    env_vars = {}
    for line in command.splitlines():
        for raw_seg in re.split(r"(?:&&|\|\||;|\|)", line):
            seg = raw_seg.strip()
            if not seg:
                continue
            try:
                tokens = shlex.split(seg)
            except ValueError:
                tokens = seg.split()
            for tok in tokens:
                m = _VAR_ASSIGN_TOKEN_RE.match(tok)
                if m:
                    key, val = tok.split("=", 1)
                    env_vars[key] = _expand_simple_vars(val, env_vars)
            if tokens and tokens[0] in ("cd", "pushd"):
                dest_raw = None
                if len(tokens) == 1:
                    dest_raw = str(Path.home())
                elif tokens[1] == "--":
                    dest_raw = tokens[2] if len(tokens) > 2 else str(Path.home())
                elif tokens[1] != "-":
                    dest_raw = tokens[1]
                if dest_raw:
                    expanded = Path(os.path.expanduser(_expand_simple_vars(dest_raw, env_vars)))
                    cur_cwd = (expanded if expanded.is_absolute() else cur_cwd / expanded).resolve(strict=False)
                    record(cur_cwd)
            for tok in tokens:
                cleaned = _expand_simple_vars(tok, env_vars)
                if "=" in cleaned and not cleaned.startswith(("/", "~", ".")):
                    cleaned = cleaned.split("=", 1)[1]
                cleaned = cleaned.lstrip("><")
                if not cleaned:
                    continue
                if cleaned.startswith(("/", "~/")) or "/" in cleaned:
                    candidate = Path(os.path.expanduser(cleaned))
                    if not candidate.is_absolute():
                        candidate = cur_cwd / candidate
                    if candidate.is_absolute():
                        kind, root, protected = inspect_governed_root(candidate)
                        if kind == "canonical" and protected and root not in canonical_roots:
                            canonical_roots.append(root)
                        elif kind == "linked" and root not in linked_roots:
                            linked_roots.append(root)

    expanded_cmd = _expand_simple_vars(command, env_vars)
    for raw_path in _ABS_OR_HOME_PATH_RE.findall(expanded_cmd):
        candidate = Path(os.path.expanduser(raw_path.rstrip(".,;:'\"")))
        kind, root, protected = inspect_governed_root(candidate)
        if kind == "canonical" and protected and root not in canonical_roots:
            canonical_roots.append(root)
        elif kind == "linked" and root not in linked_roots:
            linked_roots.append(root)

    return canonical_roots, linked_roots, uncertain


def _client_tools(client_id="claude"):
    if client_id == "grok":
        return GROK_WRITE_TOOLS, GROK_SHELL_TOOLS, GROK_READ_TOOLS
    if client_id == "codex":
        return CODEX_WRITE_TOOLS, CODEX_SHELL_TOOLS, READ_TOOLS
    if client_id == "agy":
        return AGY_WRITE_TOOLS, AGY_SHELL_TOOLS, AGY_READ_TOOLS
    return WRITE_TARGETS, frozenset({"Bash"}), READ_TOOLS


def _tool_name(payload, client_id="claude"):
    if client_id == "agy":
        call = payload.get("toolCall")
        return call.get("name") if isinstance(call, dict) else None
    if client_id == "grok":
        return payload.get("toolName", payload.get("tool_name"))
    return payload.get("tool_name")


def _tool_input(payload, client_id="claude"):
    if client_id == "agy":
        call = payload.get("toolCall")
        return call.get("args") if isinstance(call, dict) else None
    if client_id == "grok":
        return payload.get("toolInput", payload.get("tool_input"))
    return payload.get("tool_input")


def _extract_patch_targets(details):
    patch_text = None
    if isinstance(details, str):
        patch_text = details
    elif isinstance(details, dict):
        for key in ("input", "patch", "patchText", "content"):
            val = details.get(key)
            if isinstance(val, str) and val.strip():
                patch_text = val
                break
        if patch_text is None:
            for key in _AGY_PATH_KEYS:
                val = details.get(key)
                if isinstance(val, str) and val.strip():
                    return [val.strip()]
    targets = []
    if isinstance(patch_text, str):
        for raw in _PATCH_TARGET_RE.findall(patch_text):
            cleaned = raw.strip()
            if cleaned and cleaned not in targets:
                targets.append(cleaned)
    if not targets:
        raise ValueError("apply_patch target is missing")
    return targets


def _extract_write_target(tool, payload, client_id="claude"):
    details = _tool_input(payload, client_id)
    if client_id == "grok":
        keys = (
            ("notebook_path", "target_notebook")
            if tool in {"NotebookEdit", "EditNotebook"}
            else ("file_path", "path", "target_file")
        )
        targets = [details[key] for key in keys if isinstance(details, dict) and key in details]
        if (
            not targets
            or any(not isinstance(p, str) or not p.strip() for p in targets)
            or len(set(targets)) != 1
        ):
            raise ValueError("write tool target is missing or ambiguous")
        return targets[0]
    if client_id == "agy":
        keys = _AGY_NOTEBOOK_KEYS if tool == "edit_notebook" else _AGY_PATH_KEYS
        targets = [details[key] for key in keys if isinstance(details, dict) and key in details]
        if (
            not targets
            or any(not isinstance(p, str) or not p.strip() for p in targets)
            or len(set(targets)) != 1
        ):
            raise ValueError("write tool target is missing or ambiguous")
        return targets[0]
    target = details.get(WRITE_TARGETS[tool]) if isinstance(details, dict) else None
    if not isinstance(target, str) or not target:
        raise ValueError("write tool target is missing")
    return target


def _extract_write_targets(tool, payload, client_id="claude"):
    if tool == "apply_patch":
        return _extract_patch_targets(_tool_input(payload, client_id))
    return [_extract_write_target(tool, payload, client_id)]


def _extract_shell_command(tool, details, client_id="claude"):
    if not isinstance(details, dict):
        return None
    if client_id == "agy":
        if tool == "send_command_input":
            return None
        return details.get("CommandLine") or details.get("command")
    if client_id == "codex":
        return details.get("command") or details.get("cmd")
    return details.get("command")


def _effective_shell_cwd(details, path, client_id="claude"):
    if client_id == "agy" and isinstance(details, dict):
        override = details.get("Cwd") or details.get("cwd")
        if isinstance(override, str) and override.strip():
            return override
    return path


def _finish_pretool_allow(client_id):
    if client_id == "agy":
        print(json.dumps({"decision": "allow"}))
    elif client_id == "codex":
        print("{}")
    return 0


def access_arguments(event, payload, client_id="claude"):
    """Translate one hook payload into a host-check access class and target."""
    if event != "PreToolUse":
        return ["--access", "read"]
    tool = _tool_name(payload, client_id)
    write_tools, _shell_tools, read_tools = _client_tools(client_id)
    if client_id in {"grok", "agy"} and (not isinstance(tool, str) or not tool):
        raise ValueError("tool identity is missing")
    if tool in write_tools:
        target = _extract_write_targets(tool, payload, client_id)[0]
        if client_id in {"grok", "agy", "codex"}:
            p = Path(os.path.expanduser(target))
            if not p.is_absolute():
                p = Path(payload["cwd"]) / p
            target = str(p)
        return ["--access", "write", "--target", target]
    return ["--access", "read" if tool in read_tools else "exec"]


def change_directory_target(payload, cwd, client_id="claude"):
    """Return the destination of a Bash call that only changes directory.

    Such a call changes nothing in the current directory; it reads its
    destination. Checking that destination lets a session leave a checkout it
    does not hold instead of being locked out of every tool.
    """
    _write_tools, shell_tools, _read_tools = _client_tools(client_id)
    tool = _tool_name(payload, client_id)
    details = _tool_input(payload, client_id)
    command = (
        _extract_shell_command(tool, details, client_id)
        if tool in shell_tools and isinstance(details, dict)
        else None
    )
    if not isinstance(command, str) or any(
        character in command for character in ";&|<>`$(){}*?[]\n\\"
    ):
        return None
    try:
        words = shlex.split(command)
    except ValueError:
        return None
    if len(words) != 2 or words[0] != "cd":
        return None
    base_cwd = _effective_shell_cwd(details, cwd, client_id)
    return str(Path(base_cwd, os.path.expanduser(words[1])))


def _format_refusal(stdout):
    base = (
        "Controller entitlement check refused; leave with a Bash call of only "
        "`cd <directory outside this checkout>`, or use worktree-session for a governed Terminal"
    )
    try:
        decision = json.loads(stdout).get("decision", {})
        code, message = decision.get("code"), decision.get("reason")
        if isinstance(code, str) and isinstance(message, str):
            return f"{base} ({code}: {message[:240]})"
    except (ValueError, AttributeError):
        pass
    return base


def _run_writer_session(arguments):
    result = subprocess.run(
        [str(Path.home() / ".local/bin/worktree-controller"), "writer-session", *arguments],
        capture_output=True,
        text=True,
        timeout=85,
    )
    if result.returncode:
        # Do not echo hook payloads or issue a permission override.
        raise ValueError(_format_refusal(result.stdout))


def _resolve_hook_event(payload, expected, client_id):
    if not isinstance(payload, dict):
        raise ValueError("hook event identity is missing or mismatched")
    if client_id == "agy":
        event_name = payload.get("hookEventName")
    else:
        event_name = payload.get("hook_event_name")
        if client_id == "grok" and event_name not in {"SessionStart", "PreToolUse", "Stop", "SessionEnd"}:
            camel = payload.get("hookEventName", "")
            event_name = _GROK_EVENT_MAP.get(camel)
    if event_name != expected:
        raise ValueError("hook event identity is missing or mismatched")


def hook(event, client_id="claude"):
    if event not in {"SessionStart", "PreToolUse", "Stop", "SessionEnd"}:
        raise ValueError("unsupported hook event")
    payload = json.load(sys.stdin)
    _resolve_hook_event(payload, event, client_id)
    path = payload.get("cwd")
    if client_id == "agy":
        session = payload.get("conversationId")
    elif client_id == "grok":
        session = payload.get("sessionId") or payload.get("session_id")
    else:
        session = payload.get("session_id")
    if not isinstance(path, str) or not path or not isinstance(session, str) or not session:
        raise ValueError("hook path/session identity is missing")
    holder_selector = f"ancestor:{client_id}"
    hosted = "CONTROLLER_WRITER_MODE" in os.environ or "CONTROLLER_WRITER_CONTEXT" in os.environ
    if event == "Stop" and not hosted:
        if client_id == "agy" and (
            payload.get("terminationReason") != "NO_TOOL_CALL"
            or payload.get("continuationActive") is True
            or inspect_governed_root(path)[0] == "outside"
        ):
            print("{}")
            return 0
        return end_session(
            path,
            session,
            client_id=client_id,
            checking=True,
            already_continued=(
                payload.get("continuationActive") is True
                if client_id == "agy"
                else payload.get("stop_hook_active") is True
            ),
        )
    if event == "SessionEnd" and not hosted:
        return end_session(path, session, client_id=client_id)

    if event == "PreToolUse":
        tool = _tool_name(payload, client_id)
        write_tools, shell_tools, read_tools = _client_tools(client_id)

        if client_id in {"grok", "agy"} and (not isinstance(tool, str) or not tool):
            raise ValueError("tool identity is missing")

        if tool in read_tools and not hosted:
            return _finish_pretool_allow(client_id)

        if tool in write_tools:
            raw_targets = _extract_write_targets(tool, payload, client_id)
            classified = []
            for raw_target in raw_targets:
                target_path = Path(os.path.expanduser(raw_target))
                if not target_path.is_absolute():
                    target_path = Path(path) / target_path
                kind, target_root, protected = inspect_governed_root(target_path)
                if kind == "canonical" and protected:
                    raise ValueError(
                        f"Controller canonical guard refused: direct {tool} into protected canonical "
                        f"checkout '{target_root}' is forbidden; acquire a linked worktree via "
                        f"`worktree-controller acquire`."
                    )
                classified.append((raw_target, target_path, kind, target_root))
            if hosted:
                for raw_target, target_path, _kind, _target_root in classified:
                    target_arg = (
                        str(target_path)
                        if client_id in {"grok", "agy", "codex"} or tool == "apply_patch"
                        else raw_target
                    )
                    _run_writer_session(["host-check", path, "--access", "write", "--target", target_arg])
                return _finish_pretool_allow(client_id)
            for raw_target, target_path, kind, target_root in classified:
                if kind == "linked":
                    resolved_target = str(target_path.resolve(strict=False))
                    _run_writer_session([
                        "check",
                        client_id,
                        str(target_root),
                        holder_selector,
                        "--session-id",
                        session,
                        "--access",
                        "write",
                        "--target",
                        resolved_target,
                    ])
                elif kind != "outside":
                    target_arg = (
                        str(target_path)
                        if client_id in {"grok", "agy", "codex"} or tool == "apply_patch"
                        else raw_target
                    )
                    _run_writer_session([
                        "check",
                        client_id,
                        path,
                        holder_selector,
                        "--session-id",
                        session,
                        "--access",
                        "write",
                        "--target",
                        target_arg,
                    ])
            return _finish_pretool_allow(client_id)

        if tool in shell_tools:
            details = _tool_input(payload, client_id)
            command = _extract_shell_command(tool, details, client_id)
            shell_cwd = _effective_shell_cwd(details, path, client_id)
            if not hosted:
                destination = change_directory_target(payload, path, client_id)
                if destination is not None:
                    _run_writer_session([
                        "check",
                        client_id,
                        destination,
                        holder_selector,
                        "--session-id",
                        session,
                        "--access",
                        "read",
                    ])
                    return _finish_pretool_allow(client_id)
                if isinstance(command, str) and (
                    is_strict_readonly_bash(command, shell_cwd)
                    or is_safe_research_job_call(command)
                ):
                    return _finish_pretool_allow(client_id)
                canonical_roots, linked_roots, uncertain = collect_bash_governed_targets(
                    command or "", shell_cwd
                )
                if canonical_roots:
                    raise ValueError(
                        f"Controller canonical guard refused: non-readonly shell command touches "
                        f"protected canonical checkout '{canonical_roots[0]}'; acquire a linked "
                        f"worktree via `worktree-controller acquire`."
                    )
                if linked_roots:
                    for linked_root in linked_roots:
                        _run_writer_session([
                            "check",
                            client_id,
                            str(linked_root),
                            holder_selector,
                            "--session-id",
                            session,
                            "--access",
                            "exec",
                        ])
                    return _finish_pretool_allow(client_id)
                if uncertain:
                    _run_writer_session([
                        "check",
                        client_id,
                        shell_cwd,
                        holder_selector,
                        "--session-id",
                        session,
                        "--access",
                        "exec",
                    ])
                    return _finish_pretool_allow(client_id)
                return _finish_pretool_allow(client_id)
            # Hosted shell call: enforce canonical protection and host-check (plus any foreign linked worktree).
            if not (
                isinstance(command, str)
                and (
                    is_strict_readonly_bash(command, shell_cwd)
                    or is_safe_research_job_call(command)
                )
            ):
                canonical_roots, linked_roots, _uncertain = collect_bash_governed_targets(
                    command or "", shell_cwd
                )
                if canonical_roots:
                    raise ValueError(
                        f"Controller canonical guard refused: non-readonly shell command touches "
                        f"protected canonical checkout '{canonical_roots[0]}'; acquire a linked "
                        f"worktree via `worktree-controller acquire`."
                    )
                _run_writer_session(["host-check", path, "--access", "exec"])
                cwd_kind, cwd_root, _ = inspect_governed_root(Path(path))
                for linked_root in linked_roots:
                    if cwd_kind != "linked" or linked_root != cwd_root:
                        _run_writer_session(["host-check", str(linked_root), "--access", "exec"])
                return _finish_pretool_allow(client_id)

    if hosted:
        arguments = ["host-check", path, *access_arguments(event, payload, client_id)]
    else:
        destination = (
            change_directory_target(payload, path, client_id) if event == "PreToolUse" else None
        )
        arguments = [
            "check",
            client_id,
            destination or path,
            holder_selector,
            "--session-id",
            session,
            *(
                ["--access", "read"]
                if destination
                else access_arguments(event, payload, client_id)
            ),
        ]
    _run_writer_session(arguments)
    if event == "Stop" and hosted:
        if client_id == "agy" and (
            payload.get("terminationReason") != "NO_TOOL_CALL"
            or payload.get("continuationActive") is True
        ):
            print("{}")
            return 0
        return end_session(
            path,
            session,
            client_id=client_id,
            checking=True,
            hosted=True,
            already_continued=(
                payload.get("continuationActive") is True
                if client_id == "agy"
                else payload.get("stop_hook_active") is True
            ),
        )
    if event == "PreToolUse":
        return _finish_pretool_allow(client_id)
    if event == "SessionStart" and client_id in {"agy", "codex"}:
        print("{}")
    return 0


def end_session(
    path,
    session,
    checking=False,
    already_continued=False,
    hosted=False,
    client_id="claude",
):
    """Hand this session's own leased checkouts back through Controller; never fail exit.

    Direct ending calls select this live client process. Hosted preparation uses
    its verified host identity and is always read-only. Controller decides each row.
    """
    try:
        holder_selector, run_id = f"ancestor:{client_id}", None
        expected_allocations = []
        if hosted:
            if not checking:
                raise ValueError("a hosted child never ends its parent")
            # hook() already verified this context through Controller host-check.
            # Use the host's identity, not the provider's unrelated hook session ID.
            context = json.loads(os.environ["CONTROLLER_WRITER_CONTEXT"])
            path, client_id, session = (
                context[key] for key in ("repository_path", "client_id", "session_id")
            )
            run_id, pid = context["run_id"], context["holder"]["pid"]
            if (
                any(not isinstance(value, str) or not value for value in (path, client_id, session))
                or type(pid) is not int
                or pid < 1
                or (run_id is not None and (not isinstance(run_id, str) or not run_id))
            ):
                raise ValueError("host session selector is invalid")
            holder_selector = str(pid)
            expected_allocations.append(context["allocation_id"])
        else:
            described = subprocess.run(
                [
                    str(Path.home() / ".local/bin/worktree-controller"),
                    "writer-session",
                    "describe",
                    path,
                    holder_selector,
                ],
                capture_output=True,
                text=True,
                timeout=85,
            )
            projection = json.loads(described.stdout)["decision"]
            if described.returncode or not isinstance(projection, dict):
                raise ValueError("Controller session projection is unavailable")
            if projection.get("code") == "OUTSIDE_CONTROLLER_GOVERNANCE":
                if checking and client_id in {"codex", "agy"}:
                    print("{}")
                return 0
            if projection.get("code") != "WRITER_SESSION_DESCRIBED":
                raise ValueError("Controller session projection is invalid")
            path = projection["repository_path"]
            holder = (projection.get("lease") or {}).get("holder") or {}
            if (
                projection.get("holder_matches") is True
                and holder.get("client_id") == client_id
                and holder.get("session_id") == session
            ):
                run_id = holder.get("run_id")
                expected_allocations.append(projection["allocation_id"])
        if any(
            not isinstance(value, str) or str(uuid.UUID(value)) != value
            for value in expected_allocations
        ):
            raise ValueError("known allocation identity is invalid")
        result = subprocess.run(
            [
                str(Path.home() / ".local/bin/worktree-session-end"),
                "--path",
                path,
                "--client-id",
                client_id,
                "--session-id",
                session,
                "--holder",
                holder_selector,
                "--trigger",
                "task-terminal",
                *(["--run-id", run_id] if isinstance(run_id, str) and run_id else []),
                *[
                    argument
                    for allocation in expected_allocations
                    for argument in ("--expected-allocation-id", allocation)
                ],
                *(["--check"] if checking else []),
            ],
            capture_output=True,
            text=True,
            timeout=85 if checking else None,
        )
        payload = json.loads(result.stdout)
        if not isinstance(payload, dict) or any(
            not isinstance(payload.get(key, []), list)
            for key in ("allocations", "previous_allocations", "expected_allocations")
        ):
            raise ValueError("Controller session result is invalid")
        summary = payload.get("summary")
        if not isinstance(summary, dict) or summary.get("contract") != "session-closeout/v1":
            raise ValueError("Controller session result is unavailable")
        rows = [
            *payload.get("allocations", []),
            *payload.get("previous_allocations", []),
            *payload.get("expected_allocations", []),
        ]
        observed_allocations = {row.get("allocation_id") for row in rows if isinstance(row, dict)}
        complete = (
            result.returncode == 0
            and payload.get("selection_complete") is True
            and summary.get("terminal_complete") is True
            and summary.get("selected") == len(rows)
            and set(expected_allocations).issubset(observed_allocations)
            and summary.get("pending") == 0
            and all(
                isinstance(row, dict)
                and row.get("terminal_complete") is True
                and isinstance(row.get("decision"), dict)
                and isinstance(row["decision"].get("code"), str)
                and not row["decision"].get("blocker")
                and row["decision"]["code"] != "NO_TERMINAL_ACTION"
                for row in rows
            )
        )
        if checking and not complete:
            reason = (
                "Preserve this task before stopping: finalize accepted changes through Git Finalizer, "
                "push and hand off, or save its Task checkpoint and park. Classify local artifacts; "
                "keep unknown files. Recheck every known allocation with the real session selector "
                "and --expected-allocation-id; pending recovery_argv remains the recorded owner's work. "
                + json.dumps(payload, sort_keys=True)
            )
            # Stop is a turn boundary, not process exit. Give one preparation
            # turn without trapping user questions or an unresolved dependency.
            if client_id == "agy":
                print(
                    json.dumps(
                        {} if already_continued else {"decision": "continue", "reason": reason}
                    )
                )
            else:
                print(
                    json.dumps(
                        {"systemMessage": "Closeout remains pending. " + reason}
                        if already_continued
                        else {"decision": "block", "reason": reason}
                    )
                )
        elif checking and client_id in {"codex", "agy"}:
            print("{}")
        elif not checking:
            # SessionEnd is advisory; the caller gets the actual per-tree result.
            print(json.dumps(payload, sort_keys=True), file=sys.stderr)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        if checking:
            reason = (
                "Controller could not verify task preservation; keep the checkout and retry "
                "the session check."
            )
            if client_id == "agy":
                print(
                    json.dumps(
                        {"decision": "continue", "reason": reason}
                        if hosted and not already_continued
                        else {}
                    )
                )
            else:
                print(
                    json.dumps(
                        {"systemMessage": reason}
                        if already_continued
                        else {"decision": "block", "reason": reason}
                    )
                )
        else:
            print(
                "Controller session closeout is unverified; preserve the task and retry with "
                "its real selector.",
                file=sys.stderr,
            )
    return 0


def main(argv):
    name = Path(argv[0]).name
    local = Path.home() / ".local/bin"
    if name == "claude-worktree-hook":
        return hook(argv[1] if len(argv) == 2 else "", client_id="claude")
    if name == "grok-worktree-hook":
        return hook(argv[1] if len(argv) == 2 else "", client_id="grok")
    if name == "codex-worktree-hook":
        return hook(argv[1] if len(argv) == 2 else "", client_id="codex")
    if name == "agy-worktree-hook":
        event = argv[1] if len(argv) == 2 else ""
        try:
            return hook(event, client_id="agy")
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as exc:
            if event == "Stop":
                print("{}")
            else:
                print(
                    json.dumps(
                        {"decision": "deny", "reason": f"Controller consumer blocked: {exc}"}
                    )
                )
            return 0
    if name == "claude-worktree":
        arguments = [
            str(local / "worktree-session"),
            "--path",
            str(Path.cwd()),
            "--client-id",
            "claude",
            "--session-id",
            str(uuid.uuid4()),
            "--",
            "claude",
            *argv[1:],
        ]
    elif name == "grok-worktree":
        arguments = [
            str(local / "worktree-session"),
            "--path",
            str(Path.cwd()),
            "--client-id",
            "grok",
            "--session-id",
            str(uuid.uuid4()),
            "--",
            "grok",
            *argv[1:],
        ]
    elif name == "codex-worktree-writer-lease":
        arguments = [
            str(local / "worktree-controller"),
            "writer-session",
            *controller_arguments(argv[1:]),
        ]
    elif name == "codex-worktree":
        arguments = [str(local / "worktree-controller"), *controller_arguments(argv[1:])]
    elif name == "codex-worktree-session-end":
        arguments = [str(local / "worktree-session-end"), *argv[1:]]
    else:
        raise ValueError("unknown Controller consumer entry point")
    os.execv(arguments[0], arguments)
    return 127


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"Controller consumer blocked: {exc}", file=sys.stderr)
        raise SystemExit(2) from exc
